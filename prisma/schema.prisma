generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ผู้ใช้งานระบบ — แต่ละคนมีบทบาทเดียวตามหลัก RBAC
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String // DATA_OWNER | DATA_STEWARD | DQ_ANALYST | DATA_ENGINEER | COMPLIANCE_OFFICER | BUSINESS_USER | EXECUTIVE | SYS_ADMIN
  status    String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// ชุดข้อมูลในระบบ (ระดับ Dataset ใช้สำหรับการแยกการเข้าถึง)
model Dataset {
  id            String  @id @default(cuid())
  name          String
  sourceType    String // CSV | EXCEL | POSTGRESQL | MSSQL | REST_API
  piiEnabled    Boolean @default(true) // PII masking by default
  classification String @default("UNCLASSIFIED") // การจำแนกประเภทข้อมูล (DataClassificationDef.id หรือ UNCLASSIFIED) — ใช้แมปกับมาตรฐานในแดชบอร์ด
  status        String @default("ACTIVE") // ACTIVE | ARCHIVED
  domainId      String? // โดเมนข้อมูลที่สังกัด (DataDomain.id) — ใช้รวมคะแนนรายโดเมนใน Executive Dashboard (v0.16.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  grants     DatasetAccess[]
  sampleRows SampleRow[]
  rules      RuleDataset[]
  runs       DqRun[]
  signals    DqSignal[]
  exceptions DqException[]
  batches    DqValidationBatch[]
  profileRuns DqProfileRun[]
  issues     DqIssue[]
  domain     DataDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([domainId])
}

// สิทธิ์การเข้าถึงชุดข้อมูลรายบทบาท (dataset-level isolation)
model DatasetAccess {
  id        String  @id @default(cuid())
  datasetId String
  roleId    String // role key เดียวกับ User.role
  level     String @default("VIEW") // VIEW | MANAGE
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, roleId])
  @@index([roleId])
}

// บันทึกการตรวจสอบย้อนหลัง — ทุกการเปลี่ยนแปลงสิทธิ์ต้องถูกบันทึก
model AuditLog {
  id        String   @id @default(cuid())
  action    String // ASSIGN_ROLE | SUSPEND_USER | ACTIVATE_USER | CREATE_USER | GRANT_ACCESS | REVOKE_ACCESS | SET_ACCESS_LEVEL | CREATE_RULE | TOGGLE_RULE | DELETE_RULE | RUN_VALIDATION | CONFIRM_SIGNAL | DISMISS_SIGNAL | REQUEST_EXCEPTION | APPROVE_EXCEPTION | REJECT_EXCEPTION
  actor     String // ผู้ดำเนินการ (email)
  target    String // ผู้ถูกกระทำ (email หรือชื่อ dataset / rule)
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// แถวข้อมูลตัวอย่าง (sandbox) สำหรับรันการตรวจสอบ — ไม่แตะข้อมูลต้นทางจริงเสมอ
model SampleRow {
  id        String   @id @default(cuid())
  datasetId String
  payload   String // JSON object ของแถวข้อมูล (คอลัมน์ → ค่า)
  createdAt DateTime @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}

// คลังเงื่อนไข (must) ส่วนกลาง — ระบบมีชุดมาตรฐานให้ (isSystem) + ผู้ใช้สร้างเพิ่มได้ และใช้ร่วมกันทั้งระบบ
model ConditionTemplate {
  id         String   @id @default(cuid())
  key        String   @unique // รหัสอ้างอิง เช่น NOT_NULL (ระบบ) หรือ CUSTOM_xxx (ผู้ใช้สร้าง)
  name       String // ชื่อแสดง (ไทย)
  nameEn     String   @default("") // ชื่อแสดง (อังกฤษ — ไม่บังคับ)
  sentence   String // ข้อความ "must ..." ภาษาอังกฤษ เช่น "match the pattern"
  dimension  String // มิติคุณภาพข้อมูล (DimensionKey)
  engineType String // เอนจินประเมินผล: NOT_NULL | EMAIL | REGEX | RANGE | IN_LIST | UNIQUE | MAX_AGE_DAYS
  params     String   @default("[]") // JSON array — นิยามพารามิเตอร์ [{key,label,type,placeholder}]
  isSystem   Boolean  @default(false) // เงื่อนไขมาตรฐานของระบบ — ลบไม่ได้
  enabled    Boolean  @default(true)
  createdBy  String? // email ผู้สร้าง (เฉพาะของผู้ใช้)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isSystem, enabled])
}

// ความสัมพันธ์กฎ ↔ ชุดข้อมูลแบบ many-to-many — กฎ 1 ข้อใช้ร่วมกับหลายชุดข้อมูลได้
model RuleDataset {
  id        String  @id @default(cuid())
  ruleId    String
  datasetId String

  rule    DqRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([ruleId, datasetId])
  @@index([datasetId])
}

// กฎตรวจสอบคุณภาพข้อมูล — สร้างจาก Rule Builder แบบ no-code และใช้ร่วมกับหลายชุดข้อมูลได้
model DqRule {
  id         String   @id @default(cuid())
  column     String
  condition  String // รหัสเงื่อนไขจากคลังเงื่อนไขส่วนกลาง (ConditionTemplate.key)
  parameters String   @default("{}") // JSON — พารามิเตอร์ของเงื่อนไข
  filter     String? // ตัวกรองไม่บังคับ (จองไว้)
  severity   String   @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  datasets   RuleDataset[]
  runs       DqRun[]
  exceptions DqException[]
}

// ผลการรันตรวจสอบรายกฎ (ประวัติย้อนหลัง) — batchId ว่าง = รอบก่อนระบบ batch (v0.12.0)
model DqRun {
  id         String   @id @default(cuid())
  ruleId     String
  datasetId  String
  batchId    String   @default("") // id ของ DqValidationBatch (เก็บเป็น string — แถวเก่าก่อน v0.12.0 = "")
  status     String // PASSED | FAILED
  totalRows  Int
  failedRows Int
  passRate   Float
  dimension  String // มิติคุณภาพข้อมูลที่กฎนี้ตรวจ
  createdAt  DateTime @default(now())

  rule    DqRule             @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dataset Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  failures DqFailureRecord[]

  @@index([datasetId, createdAt])
  @@index([batchId])
}

// รอบการตรวจสอบ 1 รอบ (กดรัน 1 ครั้ง = 1 batch ครอบผลทุกกฎ) — ใช้ drill-down ในหน้า Validation Results
model DqValidationBatch {
  id           String   @id @default(cuid())
  datasetId    String
  triggeredBy  String   @default("MANUAL") // MANUAL | MONITOR
  createdBy    String // email ผู้รัน
  totalRules   Int      @default(0)
  passedRules  Int      @default(0)
  failedRules  Int      @default(0)
  skippedRules Int      @default(0)
  overallScore Float?
  note         String   @default("")
  createdAt    DateTime @default(now())

  dataset  Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  failures DqFailureRecord[]

  @@index([datasetId, createdAt])
}

// แถวข้อมูลที่ล้มเหลวรายแถว (snapshot ตอนรัน — mask ตอนอ่านตามบทบาท ตามหลัก PDPA)
// จำกัด 200 แถวต่อกฎต่อรอบ เพื่อคุมขนาดฐานข้อมูล
model DqFailureRecord {
  id        String    @id @default(cuid())
  batchId   String
  runId     String
  datasetId String
  ruleId    String
  dimension String
  severity  String
  rowNo     Int // ลำดับแถวเริ่ม 1
  rowData   String // JSON snapshot ของแถวทั้งแถว (คอลัมน์ → ค่า)
  reason    String // เหตุผลที่ล้มเหลว (ภาษาคน ตามเอนจิน)
  status    String    @default("NEW") // NEW | FIXED | IGNORED
  statusBy  String?
  statusAt  DateTime?
  createdAt DateTime  @default(now())

  batch   DqValidationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  run     DqRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, rowNo])
  @@index([datasetId, status])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Data Profiling (v0.13.0) — สำรวจลักษณะข้อมูลจริงรายคอลัมน์ (READ-ONLY ไม่แตะต้นทาง)
// ---------------------------------------------------------------------------

// รอบการโปรไฟล์ 1 รอบ (กดรัน 1 ครั้ง = 1 profile run ของชุดข้อมูลนั้น)
model DqProfileRun {
  id              String   @id @default(cuid())
  datasetId       String
  totalRows       Int      @default(0)
  totalColumns    Int      @default(0)
  avgCompleteness Float? // ความสมบูรณ์เฉลี่ย (100 - avg null%) 0–100
  avgUniqueness   Float? // ความไม่ซ้ำเฉลี่ย (distinct%) 0–100
  piiColumnCount  Int      @default(0) // จำนวนคอลัมน์ที่สงสัยเป็น PII
  durationMs      Int      @default(0)
  createdBy       String // email ผู้รัน
  createdAt       DateTime @default(now())

  dataset Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  columns DqProfileColumn[]

  @@index([datasetId, createdAt])
}

// สถิติรายคอลัมน์ของรอบโปรไฟล์ — topValues อาจมีค่า PII → ปิดบังตอนอ่านตามบทบาท (PDPA)
model DqProfileColumn {
  id            String  @id @default(cuid())
  profileRunId  String
  columnName    String
  dataType      String // TEXT | INTEGER | NUMBER | BOOLEAN | DATE | DATETIME | EMPTY | MIXED
  totalRows     Int     @default(0)
  nullCount     Int     @default(0)
  nullPct       Float   @default(0)
  distinctCount Int     @default(0)
  distinctPct   Float   @default(0)
  minValue      String?
  maxValue      String?
  meanValue     String?
  minLength     Int?
  maxLength     Int?
  topValues     String  @default("[]") // JSON [{value,count}] สูงสุด 5 อันดับ — mask ตอนอ่านตามบทบาท
  piiSuspected  Boolean @default(false)

  profileRun DqProfileRun @relation(fields: [profileRunId], references: [id], onDelete: Cascade)

  @@unique([profileRunId, columnName])
  @@index([profileRunId])
}

// ---------------------------------------------------------------------------
// DQ Issues (v0.13.0) — ทะเบียนปัญหาคุณภาพข้อมูลที่มี lifecycle จริง
// OPEN → IN_PROGRESS → RESOLVED → CLOSED (ปิดโดยผู้อนุมัติ — แยกจากผู้แก้)
// ---------------------------------------------------------------------------

model DqIssue {
  id             String    @id @default(cuid())
  code           String    @unique // ISS-0001 …
  datasetId      String
  title          String
  description    String    @default("")
  source         String    @default("MANUAL") // MANUAL | SIGNAL | FAILURE | EXCEPTION — ที่มาของปัญหา
  sourceId       String    @default("") // id ของต้นทาง (DqSignal / DqFailureRecord) — กันสร้างซ้ำ
  dimension      String // มิติ DAMA-DMBOK
  severity       String    @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  reportedBy     String // email ผู้รายงาน
  assignedTo     String? // email ผู้รับผิดชอบ
  resolutionNote String    @default("")
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([datasetId, status])
  @@index([source, sourceId])
}

// สัญญาณที่ต้องมนุษย์ทบทวนเสมอ — ML เป็นเพียง "สัญญาณ" ไม่มีการแก้ข้อมูลอัตโนมัติ
model DqSignal {
  id         String    @id @default(cuid())
  datasetId  String
  kind       String // ML_ANOMALY | RULE_VIOLATION
  dimension  String
  title      String
  detail     String
  severity   String    @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  status     String    @default("PENDING_REVIEW") // PENDING_REVIEW | CONFIRMED | DISMISSED
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([datasetId])
}

// คำขอข้อยกเว้น — ต้องผ่านการอนุมัติโดยมนุษย์ตามบทบาทเสมอ
model DqException {
  id          String    @id @default(cuid())
  datasetId   String
  ruleId      String?
  reason      String
  requestedBy String // email ผู้ขอ
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED
  expiresAt   DateTime // ข้อยกเว้นมีวันหมดอายุเสมอ
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  rule    DqRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Data Asset — สินทรัพย์ข้อมูลที่ผู้ใช้นำเข้าเอง (CSV / JSON / Database)
// แยกจาก Dataset ของโมดูล DQ — เป็นคลังข้อมูลดิบสำหรับ Data Inventory
// ---------------------------------------------------------------------------

// สินทรัพย์ข้อมูล 1 รายการ (ผู้ใช้ตั้งชื่อเองได้)
model DataAsset {
  id          String   @id @default(cuid())
  name        String // ชื่อที่ผู้ใช้ตั้ง
  description String   @default("")
  sourceType  String // CSV | JSON | DATABASE
  sourceInfo  String   @default("{}") // JSON — รายละเอียดแหล่งที่มา (ชื่อไฟล์/ขนาด, การเชื่อมต่อแบบไม่มีรหัสผ่าน)
  piiEnabled  Boolean  @default(true) // ปิดบัง PII ตามบทบาทเมื่อแสดงใน Inventory (PDPA-first)
  domainId    String? // โดเมนข้อมูลที่สังกัด (DataDomain.id) — รองรับโดเมนย่อยได้เพราะโดเมนย่อยเองก็คือ DataDomain 1 แถว
  rowCount    Int      @default(0)
  columnCount Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  importedBy  String // email ผู้นำเข้า
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain DataDomain?       @relation(fields: [domainId], references: [id], onDelete: SetNull)
  columns DataAssetColumn[]
  records DataAssetRecord[]
  columnDomainAssignments DataDomainColumnAssignment[]

  @@index([status])
  @@index([domainId])
}

// ---------------------------------------------------------------------------
// Data Domain (v0.14.0) — โดเมนข้อมูลสำหรับจัดหมวดหมู่คลังข้อมูล (Data Inventory)
// โครงสร้าง 2 ระดับ: โดเมนหลัก (parentId = null) → โดเมนย่อย (parentId = id ของโดเมนหลัก)
// ห้ามลึกกว่า 2 ระดับ — บังคับใน API (deny-by-default)
// ---------------------------------------------------------------------------

// โดเมนข้อมูล 1 รายการ (ทั้ง "โดเมนหลัก" และ "โดเมนย่อย" ใช้ตารางนี้ร่วมกัน)
model DataDomain {
  id          String   @id @default(cuid())
  name        String // ชื่อโดเมน เช่น "ลูกค้า" (ไม่ซ้ำกันในระดับเดียวกัน — ตรวจใน API)
  nameEn      String   @default("") // ชื่อภาษาอังกฤษ (ไม่บังคับ)
  description String   @default("")
  parentId    String? // โดเมนแม่ — null = โดเมนหลัก
  color       String   @default("emerald") // คีย์สี badge (ดู DOMAIN_COLORS ใน lib/domains.ts)
  position    Int      @default(0) // ลำดับการแสดงผล
  createdBy   String // email ผู้สร้าง
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   DataDomain?  @relation("DomainTree", fields: [parentId], references: [id], onDelete: Cascade)
  children DataDomain[] @relation("DomainTree")
  assets   DataAsset[]
  datasets Dataset[] // ชุดข้อมูลในโมดูล DQ ที่สังกัดโดเมนนี้ (v0.16.0)
  columnAssignments DataDomainColumnAssignment[]

  @@index([parentId])
  @@index([position])
}

// ---------------------------------------------------------------------------
// การจัดหมวดรายคอลัมน์ (v0.15.0) — เลือกข้อมูลจากคลังข้อมูล แล้วระบุโดเมน/โดเมนย่อย
// ให้แต่ละคอลัมน์ (คอลัมน์ 1 ของ Data Asset → DataDomain 1 รายการ)
// ---------------------------------------------------------------------------

model DataDomainColumnAssignment {
  id         String   @id @default(cuid())
  assetId    String
  columnName String // ต้องเป็นคอลัมน์ที่มีจริงใน DataAssetColumn (ตรวจใน API — deny-by-default)
  domainId   String // โดเมนหลักหรือโดเมนย่อยก็ได้ (DataDomain.id)
  assignedBy String // email ผู้จัดหมวด
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  asset  DataAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  domain DataDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([assetId, columnName])
  @@index([domainId])
}

// คอลัมน์ของ Data Asset — metadata สำหรับแสดงใน Data Inventory
model DataAssetColumn {
  id       String @id @default(cuid())
  assetId  String
  name     String
  dataType String // inferred: TEXT | INTEGER | NUMBER | BOOLEAN | DATE | DATETIME | EMPTY
  position Int

  asset DataAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, name])
  @@index([assetId])
}

// แถวข้อมูลของ Data Asset (เก็บเป็น JSON รายแถว — จำกัดจำนวนแถวต่อการนำเข้า)
model DataAssetRecord {
  id      String @id @default(cuid())
  assetId String
  rowNo   Int // ลำดับแถวเริ่ม 1
  payload String // JSON object คอลัมน์ → ค่า

  asset DataAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, rowNo])
  @@index([assetId])
}
