generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ผู้ใช้งานระบบ — แต่ละคนมีบทบาทเดียวตามหลัก RBAC
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         String // DATA_OWNER | DATA_STEWARD | DQ_ANALYST | DATA_ENGINEER | COMPLIANCE_OFFICER | BUSINESS_USER | EXECUTIVE | SYS_ADMIN
  status       String   @default("ACTIVE") // ACTIVE | SUSPENDED
  passwordHash String? // scrypt (v0.33.0) — null = ยังไม่ได้ตั้งรหัสผ่าน (เข้าสู่ระบบไม่ได้จนกว่าจะตั้ง)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
}

// ชุดข้อมูลในระบบ (ระดับ Dataset ใช้สำหรับการแยกการเข้าถึง)
model Dataset {
  id            String  @id @default(cuid())
  name          String
  sourceType    String // CSV | EXCEL | POSTGRESQL | MSSQL | REST_API
  piiEnabled    Boolean @default(true) // PII masking by default
  classification String @default("UNCLASSIFIED") // การจำแนกประเภทข้อมูล (DataClassificationDef.id หรือ UNCLASSIFIED) — ใช้แมปกับมาตรฐานในแดชบอร์ด
  status        String @default("ACTIVE") // ACTIVE | ARCHIVED
  domainId      String? // โดเมนข้อมูลที่สังกัด (DataDomain.id) — ใช้รวมคะแนนรายโดเมนใน Executive Dashboard (v0.16.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  grants     DatasetAccess[]
  sampleRows SampleRow[]
  rules      RuleDataset[]
  runs       DqRun[]
  signals    DqSignal[]
  exceptions DqException[]
  batches    DqValidationBatch[]
  profileRuns DqProfileRun[]
  issues     DqIssue[]
  domain     DataDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([domainId])
}

// สิทธิ์การเข้าถึงชุดข้อมูลรายบทบาท (dataset-level isolation)
model DatasetAccess {
  id        String  @id @default(cuid())
  datasetId String
  roleId    String // role key เดียวกับ User.role
  level     String @default("VIEW") // VIEW | MANAGE
  dataset   Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([datasetId, roleId])
  @@index([roleId])
}

// บันทึกการตรวจสอบย้อนหลัง — ทุกการเปลี่ยนแปลงสิทธิ์ต้องถูกบันทึก
model AuditLog {
  id        String   @id @default(cuid())
  action    String // ASSIGN_ROLE | SUSPEND_USER | ACTIVATE_USER | CREATE_USER | GRANT_ACCESS | REVOKE_ACCESS | SET_ACCESS_LEVEL | CREATE_RULE | TOGGLE_RULE | DELETE_RULE | RUN_VALIDATION | CONFIRM_SIGNAL | DISMISS_SIGNAL | REQUEST_EXCEPTION | APPROVE_EXCEPTION | REJECT_EXCEPTION
  actor     String // ผู้ดำเนินการ (email)
  target    String // ผู้ถูกกระทำ (email หรือชื่อ dataset / rule)
  detail    String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// แถวข้อมูลตัวอย่าง (sandbox) สำหรับรันการตรวจสอบ — ไม่แตะข้อมูลต้นทางจริงเสมอ
model SampleRow {
  id        String   @id @default(cuid())
  datasetId String
  payload   String // JSON object ของแถวข้อมูล (คอลัมน์ → ค่า)
  createdAt DateTime @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}

// คลังเงื่อนไข (must) ส่วนกลาง — ระบบมีชุดมาตรฐานให้ (isSystem) + ผู้ใช้สร้างเพิ่มได้ และใช้ร่วมกันทั้งระบบ
model ConditionTemplate {
  id         String   @id @default(cuid())
  key        String   @unique // รหัสอ้างอิง เช่น NOT_NULL (ระบบ) หรือ CUSTOM_xxx (ผู้ใช้สร้าง)
  name       String // ชื่อแสดง (ไทย)
  nameEn     String   @default("") // ชื่อแสดง (อังกฤษ — ไม่บังคับ)
  sentence   String // ข้อความ "must ..." ภาษาอังกฤษ เช่น "match the pattern"
  dimension  String // มิติคุณภาพข้อมูล (DimensionKey)
  engineType String // เอนจินประเมินผล: NOT_NULL | EMAIL | REGEX | RANGE | IN_LIST | UNIQUE | MAX_AGE_DAYS
  params     String   @default("[]") // JSON array — นิยามพารามิเตอร์ [{key,label,type,placeholder}]
  isSystem   Boolean  @default(false) // เงื่อนไขมาตรฐานของระบบ — ลบไม่ได้
  enabled    Boolean  @default(true)
  createdBy  String? // email ผู้สร้าง (เฉพาะของผู้ใช้)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isSystem, enabled])
}

// ความสัมพันธ์กฎ ↔ ชุดข้อมูลแบบ many-to-many — กฎ 1 ข้อใช้ร่วมกับหลายชุดข้อมูลได้
model RuleDataset {
  id        String  @id @default(cuid())
  ruleId    String
  datasetId String

  rule    DqRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@unique([ruleId, datasetId])
  @@index([datasetId])
}

// กฎตรวจสอบคุณภาพข้อมูล — สร้างจาก Rule Builder แบบ no-code และใช้ร่วมกับหลายชุดข้อมูลได้
model DqRule {
  id            String   @id @default(cuid())
  column        String
  condition     String // รหัสเงื่อนไขจากคลังเงื่อนไขส่วนกลาง (ConditionTemplate.key)
  parameters    String   @default("{}") // JSON — พารามิเตอร์ของเงื่อนไข
  filter        String? // ตัวกรองไม่บังคับ (จองไว้)
  severity      String   @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  threshold     Float    @default(95) // ค่าผ่านขั้นต่ำ (%) — ใช้เตือนบนแดชบอร์ดผู้บริหารเมื่อ passRate ล่าสุดต่ำกว่าค่านี้ (v0.17.0)
  dataElementId String? // Data Element ที่กฎนี้ตรวจ (v0.18.0) — null = กฎแบบเดิมผูกคอลัมน์โดยตรง (ช่วงเปลี่ยนผ่าน)
  exceptionAction      String @default("") // การดำเนินการเมื่อกฎ fail: REJECT_RECORD | CREATE_ISSUE | REJECT_AND_ISSUE | OTHER (v0.22.0 — สรุปแสดงใน Mapping Detail)
  exceptionActionNote  String @default("") // รายละเอียด/คำอธิบายการดำเนินการ เช่น "Reject record and create DQ incident" (v0.22.0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  datasets   RuleDataset[]
  runs       DqRun[]
  exceptions DqException[]
  element    DataElement? @relation(fields: [dataElementId], references: [id], onDelete: SetNull)

  @@index([dataElementId])
}

// ผลการรันตรวจสอบรายกฎ (ประวัติย้อนหลัง) — batchId ว่าง = รอบก่อนระบบ batch (v0.12.0)
model DqRun {
  id            String   @id @default(cuid())
  ruleId        String
  datasetId     String
  batchId       String   @default("") // id ของ DqValidationBatch (เก็บเป็น string — แถวเก่าก่อน v0.12.0 = "")
  dataElementId String   @default("") // Data Element ที่กฎนี้ผูกตอนรัน (v0.18.0) — ว่าง = กฎแบบเดิมไม่ผูก element (snapshot ณ เวลารัน)
  status     String // PASSED | FAILED
  totalRows  Int
  failedRows Int
  passRate   Float
  dimension  String // มิติคุณภาพข้อมูลที่กฎนี้ตรวจ
  createdAt  DateTime @default(now())

  rule    DqRule             @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  dataset Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  failures DqFailureRecord[]

  @@index([datasetId, createdAt])
  @@index([batchId])
  @@index([dataElementId])
}

// รอบการตรวจสอบ 1 รอบ (กดรัน 1 ครั้ง = 1 batch ครอบผลทุกกฎ) — ใช้ drill-down ในหน้า Validation Results
model DqValidationBatch {
  id           String   @id @default(cuid())
  datasetId    String
  triggeredBy  String   @default("MANUAL") // MANUAL | MONITOR
  createdBy    String // email ผู้รัน
  totalRules   Int      @default(0)
  passedRules  Int      @default(0)
  failedRules  Int      @default(0)
  skippedRules Int      @default(0)
  overallScore Float?
  note         String   @default("")
  groupRunId   String   @default("") // รหัสกลุ่มรอบรันระดับโดเมน (v0.18.0) — batch ทุกใบที่เกิดจากรอบรันโดเมนเดียวกันใช้ค่าเดียวกัน ว่าง = รันแบบต่อชุดข้อมูล
  createdAt    DateTime @default(now())

  dataset  Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  failures DqFailureRecord[]

  @@index([datasetId, createdAt])
  @@index([groupRunId])
}

// แถวข้อมูลที่ล้มเหลวรายแถว (snapshot ตอนรัน — mask ตอนอ่านตามบทบาท ตามหลัก PDPA)
// จำกัด 200 แถวต่อกฎต่อรอบ เพื่อคุมขนาดฐานข้อมูล
model DqFailureRecord {
  id        String    @id @default(cuid())
  batchId   String
  runId     String
  datasetId String
  ruleId    String
  dimension String
  severity  String
  rowNo     Int // ลำดับแถวเริ่ม 1
  rowData   String // JSON snapshot ของแถวทั้งแถว (คอลัมน์ → ค่า)
  reason    String // เหตุผลที่ล้มเหลว (ภาษาคน ตามเอนจิน)
  status    String    @default("NEW") // NEW | FIXED | IGNORED
  statusBy  String?
  statusAt  DateTime?
  createdAt DateTime  @default(now())

  batch   DqValidationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  run     DqRun             @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, rowNo])
  @@index([datasetId, status])
  @@index([batchId])
}

// ---------------------------------------------------------------------------
// Data Profiling (v0.13.0) — สำรวจลักษณะข้อมูลจริงรายคอลัมน์ (READ-ONLY ไม่แตะต้นทาง)
// ---------------------------------------------------------------------------

// รอบการโปรไฟล์ 1 รอบ (กดรัน 1 ครั้ง = 1 profile run ของชุดข้อมูลนั้น)
model DqProfileRun {
  id              String   @id @default(cuid())
  datasetId       String
  totalRows       Int      @default(0)
  totalColumns    Int      @default(0)
  avgCompleteness Float? // ความสมบูรณ์เฉลี่ย (100 - avg null%) 0–100
  avgUniqueness   Float? // ความไม่ซ้ำเฉลี่ย (distinct%) 0–100
  piiColumnCount  Int      @default(0) // จำนวนคอลัมน์ที่สงสัยเป็น PII
  durationMs      Int      @default(0)
  createdBy       String // email ผู้รัน
  createdAt       DateTime @default(now())

  dataset Dataset           @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  columns DqProfileColumn[]

  @@index([datasetId, createdAt])
}

// สถิติรายคอลัมน์ของรอบโปรไฟล์ — topValues อาจมีค่า PII → ปิดบังตอนอ่านตามบทบาท (PDPA)
model DqProfileColumn {
  id            String  @id @default(cuid())
  profileRunId  String
  columnName    String
  dataType      String // TEXT | INTEGER | NUMBER | BOOLEAN | DATE | DATETIME | EMPTY | MIXED
  totalRows     Int     @default(0)
  nullCount     Int     @default(0)
  nullPct       Float   @default(0)
  distinctCount Int     @default(0)
  distinctPct   Float   @default(0)
  minValue      String?
  maxValue      String?
  meanValue     String?
  minLength     Int?
  maxLength     Int?
  topValues     String  @default("[]") // JSON [{value,count}] สูงสุด 5 อันดับ — mask ตอนอ่านตามบทบาท
  piiSuspected  Boolean @default(false)

  profileRun DqProfileRun @relation(fields: [profileRunId], references: [id], onDelete: Cascade)

  @@unique([profileRunId, columnName])
  @@index([profileRunId])
}

// ---------------------------------------------------------------------------
// DQ Issues (v0.13.0) — ทะเบียนปัญหาคุณภาพข้อมูลที่มี lifecycle จริง
// OPEN → IN_PROGRESS → RESOLVED → CLOSED (ปิดโดยผู้อนุมัติ — แยกจากผู้แก้)
// ---------------------------------------------------------------------------

model DqIssue {
  id             String    @id @default(cuid())
  code           String    @unique // ISS-0001 …
  datasetId      String
  title          String
  description    String    @default("")
  source         String    @default("MANUAL") // MANUAL | SIGNAL | FAILURE | EXCEPTION — ที่มาของปัญหา
  sourceId       String    @default("") // id ของต้นทาง (DqSignal / DqFailureRecord) — กันสร้างซ้ำ
  dimension      String // มิติ DAMA-DMBOK
  severity       String    @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  status         String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  dueAt          DateTime? // วันครบกำหนดของปัญหา (ตั้งเองต่อปัญหา — ใช้ตรวจ "เกิน SLA" บนแดชบอร์ดผู้บริหาร v0.17.0)
  reportedBy     String // email ผู้รายงาน
  assignedTo     String? // email ผู้รับผิดชอบ
  resolutionNote String    @default("")
  detectedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([datasetId, status])
  @@index([source, sourceId])
}

// สัญญาณที่ต้องมนุษย์ทบทวนเสมอ — ML เป็นเพียง "สัญญาณ" ไม่มีการแก้ข้อมูลอัตโนมัติ
model DqSignal {
  id         String    @id @default(cuid())
  datasetId  String
  kind       String // ML_ANOMALY | RULE_VIOLATION
  dimension  String
  title      String
  detail     String
  severity   String    @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  status     String    @default("PENDING_REVIEW") // PENDING_REVIEW | CONFIRMED | DISMISSED
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([datasetId])
}

// ข้อยกเว้นกฎ (v0.36.0 — RBAC ตามบทบาทล้วน ไม่มีคิวอนุมัติ) — ผู้มีสิทธิ์ขอ = ใช้ได้ทันทีจนถึงวันหมดอายุ · ผู้มีสิทธิ์ยกเลิกหยุดใช้ได้ทันที (ทุก action บันทึก Audit Trail)
model DqException {
  id          String    @id @default(cuid())
  datasetId   String
  ruleId      String?
  reason      String
  requestedBy String // email ผู้ขอใช้ข้อยกเว้น
  status      String    @default("APPROVED") // APPROVED (ใช้งานอยู่จนถึงวันหมดอายุ) | REVOKED (ยกเลิกแล้ว)
  expiresAt   DateTime // ข้อยกเว้นมีวันหมดอายุเสมอ
  revokedBy   String? // email ผู้ยกเลิก (บันทึก Audit Trail ทุกครั้ง)
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  rule    DqRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ---------------------------------------------------------------------------
// Data Asset — สินทรัพย์ข้อมูลที่ผู้ใช้นำเข้าเอง (CSV / JSON / Database)
// แยกจาก Dataset ของโมดูล DQ — เป็นคลังข้อมูลดิบสำหรับ Data Inventory
// ---------------------------------------------------------------------------

// สินทรัพย์ข้อมูล 1 รายการ (ผู้ใช้ตั้งชื่อเองได้)
model DataAsset {
  id          String   @id @default(cuid())
  name        String // ชื่อที่ผู้ใช้ตั้ง
  description String   @default("")
  sourceType  String // CSV | JSON | DATABASE
  sourceInfo  String   @default("{}") // JSON — รายละเอียดแหล่งที่มา (ชื่อไฟล์/ขนาด, การเชื่อมต่อแบบไม่มีรหัสผ่าน)
  schemaName  String   @default("") // ชื่อ Schema กายภาพ เช่น CUSTOMER (v0.22.0 — แสดงใน Mapping Detail)
  tableName   String   @default("") // ชื่อตารางกายภาพ เช่น customer_master (v0.22.0 — แสดงใน Mapping Detail)
  piiEnabled  Boolean  @default(true) // ปิดบัง PII ตามบทบาทเมื่อแสดงใน Inventory (PDPA-first)
  domainId    String? // โดเมนข้อมูลที่สังกัด (DataDomain.id) — รองรับโดเมนย่อยได้เพราะโดเมนย่อยเองก็คือ DataDomain 1 แถว
  rowCount    Int      @default(0)
  columnCount Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE | ARCHIVED
  importedBy  String // email ผู้นำเข้า
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  domain DataDomain?       @relation(fields: [domainId], references: [id], onDelete: SetNull)
  columns DataAssetColumn[]
  records DataAssetRecord[]
  columnDomainAssignments DataDomainColumnAssignment[]
  elementMappings DataElementColumnMapping[]

  @@index([status])
  @@index([domainId])
}

// ---------------------------------------------------------------------------
// Data Domain (v0.14.0) — โดเมนข้อมูลสำหรับจัดหมวดหมู่คลังข้อมูล (Data Inventory)
// โครงสร้าง 2 ระดับ: โดเมนหลัก (parentId = null) → โดเมนย่อย (parentId = id ของโดเมนหลัก)
// ห้ามลึกกว่า 2 ระดับ — บังคับใน API (deny-by-default)
// ---------------------------------------------------------------------------

// โดเมนข้อมูล 1 รายการ (ทั้ง "โดเมนหลัก" และ "โดเมนย่อย" ใช้ตารางนี้ร่วมกัน)
model DataDomain {
  id          String   @id @default(cuid())
  name        String // ชื่อโดเมน เช่น "ลูกค้า" (ไม่ซ้ำกันในระดับเดียวกัน — ตรวจใน API)
  nameEn      String   @default("") // ชื่อภาษาอังกฤษ (ไม่บังคับ)
  description String   @default("")
  parentId    String? // โดเมนแม่ — null = โดเมนหลัก
  color       String   @default("emerald") // คีย์สี badge (ดู DOMAIN_COLORS ใน lib/domains.ts)
  position    Int      @default(0) // ลำดับการแสดงผล
  createdBy   String // email ผู้สร้าง
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   DataDomain?  @relation("DomainTree", fields: [parentId], references: [id], onDelete: Cascade)
  children DataDomain[] @relation("DomainTree")
  assets   DataAsset[]
  datasets Dataset[] // ชุดข้อมูลในโมดูล DQ ที่สังกัดโดเมนนี้ (v0.16.0)
  columnAssignments DataDomainColumnAssignment[]
  elements DataElement[] // Data Element ที่แขวนใต้โดเมนนี้ (เฉพาะโดเมนย่อย — v0.18.0)
  referenceSets ReferenceSet[] // ทะเบียนข้อมูลอ้างอิงที่แขวนใต้โดเมนย่อยนี้ (v0.31.0)

  @@index([parentId])
  @@index([position])
}

// ---------------------------------------------------------------------------
// การจัดหมวดรายคอลัมน์ (v0.15.0) — เลือกข้อมูลจากคลังข้อมูล แล้วระบุโดเมน/โดเมนย่อย
// ให้แต่ละคอลัมน์ (คอลัมน์ 1 ของ Data Asset → DataDomain 1 รายการ)
// ---------------------------------------------------------------------------

model DataDomainColumnAssignment {
  id         String   @id @default(cuid())
  assetId    String
  columnName String // ต้องเป็นคอลัมน์ที่มีจริงใน DataAssetColumn (ตรวจใน API — deny-by-default)
  domainId   String // โดเมนหลักหรือโดเมนย่อยก็ได้ (DataDomain.id)
  assignedBy String // email ผู้จัดหมวด
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  asset  DataAsset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  domain DataDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([assetId, columnName])
  @@index([domainId])
}

// ---------------------------------------------------------------------------
// Data Element (v0.18.0) — องค์ประกอบข้อมูลเชิงตรรกะ ใต้โดเมนย่อยเสมอ (บังคับใน API)
// ตามแนวคิด ISO/IEC 11179: Naming & Definition / Representation / Value Domain /
// Administrative attributes — เป็นจุดผูก DQ Rule แทนการผูกคอลัมน์ดิบโดยตรง
// ---------------------------------------------------------------------------

model DataElement {
  id             String   @id @default(cuid())
  code           String   @unique // รหัสระบบ EL-0001 … (สร้างอัตโนมัติ)
  subDomainId    String // ต้องเป็นโดเมนย่อย (parentId != null) — ตรวจใน API (deny-by-default)
  nameTh         String // ชื่อ (ไม่ซ้ำในโดเมนย่อยเดียวกัน — ตรวจใน API)
  nameEn         String   @default("") // ชื่อภาษาอังกฤษ
  definition     String   @default("") // นิยามทางธุรกิจ (ISO 11179: Definition)
  examples       String   @default("") // ตัวอย่างค่า
  dataType       String   @default("TEXT") // TEXT | INTEGER | NUMBER | BOOLEAN | DATE | DATETIME
  formatPattern  String   @default("") // รูปแบบ/พาเทิร์น เช่น regex หรือ DD/MM/YYYY
  valueDomain    String   @default("") // ค่าอนุญาต/ช่วงค่า (ISO 11179: Value Domain)
  maxLength      Int? // ความยาวสูงสุด (null = ไม่ระบุ)
  unit           String   @default("") // หน่วย เช่น THB, %
  ownerId        String? // email เจ้าของข้อมูล (Data Owner) — เลือกจากผู้ใช้ในระบบ (ISO 11179: Steward / Responsible)
  stewardId      String? // email ผู้ดูแลข้อมูล (Data Steward) — เลือกจากผู้ใช้ในระบบ คนละ 1 คนต่อบทบาท (v0.20.0)
  custodianId    String? // email ผู้เก็บรักษาข้อมูล (Data Custodian) — เลือกจากผู้ใช้ในระบบ คนละ 1 คนต่อบทบาท (v0.20.0)
  pii            Boolean  @default(false) // เป็นข้อมูลส่วนบุคคล (PDPA)
  classification String   @default("UNCLASSIFIED") // การจำแนกข้อมูล (DataClassificationDef.id หรือ UNCLASSIFIED)
  isCde          Boolean  @default(false) // Critical Data Element — ข้อมูลวิกฤตต่อองค์กร (ผลจริง: แดชบอร์ดผู้บริหารนับความครอบคลุม/คะแนนต่ำ, เตือนเมื่อยังไม่มีกฎ) (v0.20.0)
  isFinancial    Boolean  @default(false) // ผลกระทบต่อการรายงานทางการเงิน (ผลจริง: แดชบอร์ดผู้บริหารนับความเสี่ยงรายงานเงิน) (v0.20.0)
  status         String   @default("ACTIVE") // DRAFT | ACTIVE | DEPRECATED (ISO 11179: registration status) — เปิดใช้งาน/เลิกใช้โดยตรงด้วยสิทธิ์ MANAGE_DATASETS (v0.36.0 ไม่มีคิวอนุมัติ)
  opUpdateFrequency String @default("") // เชิงปฏิบัติการ (กรอกมือ): ความถี่การปรับปรุง REALTIME|HOURLY|DAILY|WEEKLY|MONTHLY|ON_DEMAND (v0.20.0)
  opNotes        String   @default("") // เชิงปฏิบัติการ (กรอกมือ): หมายเหตุ เช่น ช่วงเวลาโหลด, ผู้รับผิดชอบรอบ (v0.20.0)
  position       Int      @default(0) // ลำดับการแสดงผล
  customFields   String   @default("{}") // JSON object — field เสริมตามองค์กรกำหนด
  createdBy      String // email ผู้สร้าง
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subDomain      DataDomain                 @relation(fields: [subDomainId], references: [id], onDelete: Cascade)
  columnMappings DataElementColumnMapping[]
  rules          DqRule[]
  referenceSetId String? // ทะเบียนข้อมูลอ้างอิงที่ valueDomain ผูกไว้ (ReferenceSet.id) — โครงสร้างแทนข้อความอิสระ (v0.31.0)
  referenceSet   ReferenceSet? @relation(fields: [referenceSetId], references: [id], onDelete: SetNull)
  mappingsAsSource DataMapping[] @relation("MappingSource") // Data Mapping ที่ element นี้เป็นต้นทาง (v0.21.0)
  mappingsAsTarget DataMapping[] @relation("MappingTarget") // Data Mapping ที่ element นี้เป็นปลายทาง (v0.21.0)
  // หมายเหตุ: DqRun.dataElementId เป็น snapshot แบบ string (ไม่ใช่ FK) เพื่อคงประวัติแม้ลบ element — คิวรีด้วย where dataElementId

  @@unique([subDomainId, nameTh])
  @@index([subDomainId, status])
}

// ---------------------------------------------------------------------------
// Data Mapping (v0.21.0) — เส้นเชื่อมระหว่าง Data Element 2 ตัว (ต้นทาง → ปลายทาง)
// เพื่อระบุว่าเป็น "ข้อมูลชนิดเดียวกัน" หรือข้อมูลที่ไหลแปลงกันข้ามระบบ/ข้ามโดเมน
// ปลายทางต้องเป็น Data Element ที่ลงทะเบียนในระบบเท่านั้น (ตรวจใน API — deny-by-default)
// แมปข้าม Data Domain ได้ · แต่ละคู่ (A→B) แมปได้ 1 เส้น และห้ามแมปย้อนทิศ (B→A) ซ้ำ
// สถานะเปลี่ยนตรงด้วยสิทธิ์ MANAGE_DATASETS: DRAFT → ACTIVE (เปิดใช้งาน) → DEPRECATED (v0.36.0 ไม่มีคิวอนุมัติ)
// ---------------------------------------------------------------------------

model DataMapping {
  id              String    @id @default(cuid())
  code            String    @unique // รหัสระบบ MP-0001 … (สร้างอัตโนมัติ)
  sourceElementId String // Data Element ต้นทาง — ข้อมูลไหล "เข้า"
  targetElementId String // Data Element ปลายทาง — ข้อมูลไหล "ออก"
  mappingType     String    @default("DIRECT") // DIRECT | TRANSFORM | DERIVED | AGGREGATE | LOOKUP (ดู MAPPING_TYPES ใน lib/mappings.ts)
  transformNote   String    @default("") // รายละเอียดการแปลง/สูตร/ตารางอ้างอิง (บังคับเมื่อ mappingType != DIRECT — ตรวจใน API)
  note            String    @default("") // หมายเหตุเพิ่มเติม
  status          String    @default("DRAFT") // DRAFT | ACTIVE | DEPRECATED — เปิดใช้งาน/เลิกใช้ตรงด้วยสิทธิ์ MANAGE_DATASETS (v0.36.0 ไม่มีคิวอนุมัติ)
  version         String    @default("1.0") // เวอร์ชันสเปก: อัตโนมัติ +0.1 ทุกครั้งที่แก้เนื้อหาขณะใช้งานอยู่ (ACTIVE) + ปรับมือได้ด้วยสิทธิ์ MANAGE_DATASETS (v0.36.0)
  createdBy       String // email ผู้สร้าง
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  source DataElement @relation("MappingSource", fields: [sourceElementId], references: [id], onDelete: Restrict) // ลบ element ไม่ได้ถ้ายังมี mapping ผูกอยู่
  target DataElement @relation("MappingTarget", fields: [targetElementId], references: [id], onDelete: Restrict)
  lookupSetId String? // ทะเบียนข้อมูลอ้างอิงที่ใช้แมป (เฉพาะ mappingType = LOOKUP — v0.31.0)
  lookupSet   ReferenceSet? @relation(fields: [lookupSetId], references: [id], onDelete: SetNull)

  @@unique([sourceElementId, targetElementId])
  @@index([targetElementId])
  @@index([status])
}

// การแมป Data Element ↔ คอลัมน์จริงในคลังข้อมูล (Data Asset)
// 1 element แมปได้หลายคอลัมน์ข้ามหลาย asset (เชิงตรรกะ) — ใช้แสดง "ที่มา" และแนะนำคอลัมน์ตอนสร้างกฎ
model DataElementColumnMapping {
  id         String   @id @default(cuid())
  elementId  String
  assetId    String
  columnName String // ต้องเป็นคอลัมน์ที่มีจริงใน DataAssetColumn (ตรวจใน API — deny-by-default)
  note       String   @default("")
  mappedBy   String // email ผู้แมป
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  element DataElement @relation(fields: [elementId], references: [id], onDelete: Cascade)
  asset   DataAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([elementId, assetId, columnName])
  @@index([assetId, columnName])
}

// ---------------------------------------------------------------------------
// Reference Data (v0.31.0) — ทะเบียนค่าอ้างอิงศูนย์กลาง (DAMA-DMBOK: Reference Data Management)
// ปัญหาที่แก้: ค่ามาตรฐานถูก "พิมพ์แปะ" กระจาย 3 จุด — valueDomain (ข้อความอิสระ),
// IN_LIST/REFERENCE_MATCH (ค่าแปะในกฎแต่ละข้อ), LOOKUP mapping (อ้างข้อความลอย ๆ)
// → รวมเป็นทะเบียนเดียว แก้ที่ต้นทางจุดเดียว กฎ/Element/Mapping ที่ผูกไว้ใช้ค่าใหม่ทันที
// โครงสร้าง: ReferenceSet (ทะเบียน) 1 → ReferenceValue (ค่าอ้างอิง) หลายค่า
// สถานะเปลี่ยนตรงด้วยสิทธิ์ MANAGE_DATASETS: DRAFT → ACTIVE (เปิดใช้งาน) → DEPRECATED (v0.36.0 ไม่มีคิวอนุมัติ)
// เวอร์ชัน +0.1 อัตโนมัติเมื่อแก้เนื้อหาทะเบียนขณะใช้งานอยู่ (ACTIVE)
// เอนจิน: กฎ IN_LIST/REFERENCE_MATCH ที่ params.referenceSetId ชี้มาที่นี่ จะใช้เฉพาะค่า ACTIVE ของทะเบียน
// ---------------------------------------------------------------------------

// ทะเบียนข้อมูลอ้างอิง 1 รายการ (เช่น สกุลเงินมาตรฐาน ISO 4217 · รหัสประเทศ · กลุ่มลูกค้า)
model ReferenceSet {
  id              String   @id @default(cuid())
  code            String   @unique // รหัสระบบ RD-0001 … (สร้างอัตโนมัติ)
  name            String // ชื่อทะเบียน (ไม่ซ้ำกันทั้งระบบ — ตรวจใน API เพราะแสดงใน picker ของกฎ)
  nameEn          String   @default("") // ชื่อภาษาอังกฤษ (ไม่บังคับ)
  description     String   @default("")
  subDomainId     String // ต้องเป็นโดเมนย่อย (parentId != null) — เจ้าของทะเบียน (ตรวจใน API — deny-by-default)
  ownerId         String? // email เจ้าของข้อมูล (Data Owner) — ต้องเป็นผู้ใช้ ACTIVE (ตรวจใน API)
  stewardId       String? // email ผู้ดูแลข้อมูล (Data Steward) — ต้องเป็นผู้ใช้ ACTIVE (ตรวจใน API)
  status          String   @default("DRAFT") // DRAFT | ACTIVE | DEPRECATED — เปิดใช้งาน/เลิกใช้ตรงด้วยสิทธิ์ MANAGE_DATASETS (v0.36.0 ไม่มีคิวอนุมัติ)
  version         String   @default("1.0") // เวอร์ชันสเปก: +0.1 อัตโนมัติเมื่อแก้เนื้อหาขณะใช้งานอยู่ (ACTIVE)
  createdBy       String // email ผู้สร้าง
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subDomain DataDomain       @relation(fields: [subDomainId], references: [id], onDelete: Restrict) // ลบโดเมนย่อยไม่ได้ถ้ายังมีทะเบียน
  values    ReferenceValue[]
  elements  DataElement[] // Element ที่ valueDomain ผูกทะเบียนนี้
  lookupMappings DataMapping[] // Mapping แบบ LOOKUP ที่อ้างทะเบียนนี้

  @@index([subDomainId, status])
  @@index([status])
}

// ค่าอ้างอิง 1 ค่าในทะเบียน — ห้ามซ้ำในทะเบียนเดียวกัน · เลิกใช้ด้วยสถานะ RETIRED (ไม่ลบ — คงประวัติ audit)
model ReferenceValue {
  id         String   @id @default(cuid())
  setId      String
  value      String // รหัส/ค่า เช่น USD, THB (ไม่ซ้ำในทะเบียนเดียวกัน — ตรวจใน API)
  labelTh    String   @default("") // ชื่อเรียกภาษาไทย เช่น ดอลลาร์สหรัฐ
  labelEn    String   @default("") // ชื่อเรียกภาษาอังกฤษ
  definition String   @default("") // นิยาม/หมายเหตุของค่า
  sortOrder  Int      @default(0) // ลำดับการแสดงผล
  status     String   @default("ACTIVE") // ACTIVE | RETIRED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  set ReferenceSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([setId, value])
  @@index([setId, status])
}

// คอลัมน์ของ Data Asset — metadata สำหรับแสดงใน Data Inventory
model DataAssetColumn {
  id           String @id @default(cuid())
  assetId      String
  name         String
  dataType     String // inferred: TEXT | INTEGER | NUMBER | BOOLEAN | DATE | DATETIME | EMPTY
  physicalType String @default("") // ประเภทข้อมูลกายภาพตามระบบต้นทาง เช่น VARCHAR(20) (v0.22.0 — แสดงใน Mapping Detail)
  position     Int

  asset DataAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, name])
  @@index([assetId])
}

// แถวข้อมูลของ Data Asset (เก็บเป็น JSON รายแถว — จำกัดจำนวนแถวต่อการนำเข้า)
model DataAssetRecord {
  id      String @id @default(cuid())
  assetId String
  rowNo   Int // ลำดับแถวเริ่ม 1
  payload String // JSON object คอลัมน์ → ค่า

  asset DataAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, rowNo])
  @@index([assetId])
}

// ---------------------------------------------------------------------------
// ML Studio (v0.35.0) — สร้างใหม่ทั้งหมดบนหลัก Train/Test (แทนระบบ ML เดิม v0.25–v0.28)
// หลักการ: ML เป็น "ผู้ช่วย (Assistant)" เท่านั้น — ความถูกต้องและความแม่นยำขึ้นอยู่กับการเทรน 3 อย่าง:
//   1) ข้อมูล (Data Asset)  2) DQ Rule (ผู้ติดป้าย — บอกว่าไม่ถูกต้องอย่างไรและเพราะอะไร)  3) คนสอน (human-in-the-loop)
// ชุดฝึก (Train set) = ข้อมูลจริงจาก Data Asset แยกตาม Data Domain
// ชุดทดสอบ (Test set) = แบ่งแถวตาม % ที่ตั้งค่า — ใช้วัดความแม่นยำของโมเดล (accuracy/precision/recall/F1)
// ทุกการเทรนสร้าง "เวอร์ชัน" ใหม่เก็บในระบบ — โดเมนไหนมีข้อมูล/label มาก เทรนบ่อย แม่นขึ้น
// ข้อมูลเทรนอยู่ในระบบเสมอ export/import เฉพาะ "พารามิเตอร์โมเดล" (สถิติรวม ไม่มีข้อมูลดิบ/PII)
// ---------------------------------------------------------------------------

// เวอร์ชันโมเดล 1 รายการต่อการเทรน 1 ครั้ง — แยกตาม Data Domain
model MlModelVersion {
  id          String    @id @default(cuid())
  version     Int       // ลำดับเวอร์ชันรายโดเมน (1, 2, 3, …)
  domainId    String    @default("") // DataDomain.id — "" = รวมทุกโดเมน (ทั่วทั้งระบบ)
  status      String    @default("TRAINED") // TRAINED | ACTIVE | ARCHIVED — ACTIVE ได้ 1 เวอร์ชันต่อโดเมน
  trainPct    Int       // % แบ่งชุดฝึก ณ ตอนเทรน (70 = ฝึก 70% / ทดสอบ 30%)
  // คุณภาพที่วัดจากชุดทดสอบ (test split) — ตัวเลขจริงจากเอนจิน scikit-learn ไม่ประมาณ
  accuracy    Float? // (TP+TN) / ทั้งหมด
  precision   Float? // TP / (TP+FP) — ตัดสิน "ไม่ถูกต้อง" แม่นแค่ไหน
  recall      Float? // TP / (TP+FN) — จับ "ไม่ถูกต้อง" ได้ครบแค่ไหน
  f1          Float?
  rocAuc      Float? // ความสามารถจำแนกถูก/ไม่ถูกต้อง (0.5 = สุ่ม, 1.0 = แยกสมบูรณ์) — จาก scikit-learn
  // ขนาดข้อมูลที่ใช้เทรนจริง
  trainRows   Int       @default(0)
  testRows    Int       @default(0)
  assetCount  Int       @default(0)
  ruleCount   Int       @default(0) // จำนวนกฎที่ทำหน้าที่ผู้ติดป้าย (ไม่นับกฎที่ข้ามเพราะต้องใช้บริบทภายนอก)
  labelCount  Int       @default(0) // จำนวน label จากมนุษย์ (CONFIRMED/OVERRIDDEN) + สุ่มตรวจ ที่ถูกใช้ในการเทรนนี้
  // พารามิเตอร์โมเดล = เกณฑ์ที่เรียนรู้จากชุดฝึก (สถิติรวมรายคอลัมน์/รายมิติ — ไม่มีข้อมูลดิบ ไม่มี PII)
  paramsJson  String    @default("{}")
  // สถิติประกอบการอธิบาย (โปรไฟล์รายคอลัมน์ 9 มิติ + สาเหตุที่พบบ่อย)
  statsJson   String    @default("{}")
  trainedBy   String    // email ผู้เทรน
  note        String    @default("")
  activatedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([domainId, version])
  @@index([domainId, status])
}

// คลัง label — คำตัดสินของโมเดลรายแถว + การตรวจยืนยันโดยมนุษย์ (human-in-the-loop)
// มนุษย์ flag: CONFIRMED = เห็นด้วยกับ ML · OVERRIDDEN = แก้คำตัดสิน ML → ทั้งคู่เป็น "ข้อมูลสอน" สำหรับ retrain
// เก็บแยกจากเวอร์ชัน (versionId เป็น string ไม่ผูก FK) — ลบเวอร์ชันเก่าแล้วข้อมูลสอนยังอยู่
model MlLabelItem {
  id            String    @id @default(cuid())
  versionId     String    // เวอร์ชันโมเดลที่ตัดสิน (string — ไม่ผูก FK เพื่อเก็บข้อมูลสอนถาวร)
  version       Int       @default(0) // เลขเวอร์ชัน (แสดงง่าย)
  domainId      String    @default("")
  assetId       String    // DataAsset ต้นทางของแถว
  assetName     String    @default("") // ชื่อ asset (snapshot — แสดงโดยไม่ต้อง join)
  rowNo         Int       // ลำดับแถวใน Data Asset
  rowDataJson   String    // snapshot คอลัมน์ → ค่า (mask ตามบทบาทตอนอ่าน เช่นเดียวกับ DqFailureRecord)
  mlVerdict     String    // INCORRECT | CORRECT | SUSPECT
  mlReason      String    @default("") // เหตุผลภาษามนุษย์ เช่น "คอลัมน์ email ว่าง = ไม่ถูกต้องเพราะไม่มีข้อมูล"
  mlScore       Float     @default(0) // ความเชื่อมั่น 0–1
  humanFlag     String?   // null = ยังไม่ตรวจ | CONFIRMED | OVERRIDDEN
  humanNote     String    @default("")
  labeledBy     String?   // email ผู้ตรวจ (human-in-the-loop)
  labeledAt     DateTime?
  usedInVersion Int       @default(0) // เวอร์ชันล่าสุดที่ label นี้ถูกใช้เทรน (กันนับซ้ำข้ามการเทรน)
  createdAt     DateTime  @default(now())

  @@unique([versionId, assetId, rowNo])
  @@index([domainId, humanFlag])
  @@index([assetId, rowNo])
}

// สุ่มตรวจ — สุ่มแถวจาก Data Asset ให้ "มนุษย์เป็นผู้ตัดสิน" (ML ให้คำแนะนำประกอบเท่านั้น)
// คำตัดสินของมนุษย์ = ความจริง (ground truth) ที่สอนโมเดล → เข้าชุดฝึกในการเทรนถัดไป
model MlAuditSample {
  id            String    @id @default(cuid())
  batchNo       Int       // รอบสุ่มที่ (1, 2, … — นับรวมทั้งระบบ)
  domainId      String    @default("")
  assetId       String
  assetName     String    @default("")
  rowNo         Int
  rowDataJson   String    // snapshot แถว (mask ตามบทบาทตอนอ่าน)
  mlAdvice      String    @default("") // คำแนะนำจากเวอร์ชัน ACTIVE ณ ตอนสุ่ม (ว่าง = ยังไม่มีโมเดล)
  mlScore       Float     @default(0)
  mlVerdict     String    @default("") // คำตัดสินที่ ML เสนอ: INCORRECT | CORRECT | "" (ไม่มีคำแนะนำ)
  humanVerdict  String?   // CORRECT | INCORRECT — ตัดสินโดยมนุษย์ = ความจริง
  humanReason   String    @default("")
  dimension     String    @default("") // มิติที่เกี่ยว (เมื่อตัดสินไม่ถูกต้อง) — DimensionKey
  auditedBy     String?   // email ผู้ตัดสิน
  auditedAt     DateTime?
  usedInVersion Int       @default(0)
  createdAt     DateTime  @default(now())

  @@unique([batchNo, assetId, rowNo])
  @@index([batchNo])
  @@index([domainId, humanVerdict])
}

// เกณฑ์ของ ML Studio (v0.35.0) — singleton แถวเดียวของระบบ (id = 1) — แทน DqMlSettings เดิม
// ทุกการแก้ค่าบันทึก AuditLog (action: SET_ML_SETTINGS)
model MlSettings {
  id               Int      @id @default(1)
  trainPct         Int      @default(70) // % ชุดฝึกเริ่มต้น (70 = ฝึก 70 / ทดสอบ 30) — ปรับรายการเทรนได้
  minTrainRows     Int      @default(30) // แถวชุดฝึกขั้นต่ำที่จะเทรนได้
  minTestRows      Int      @default(10) // แถวชุดทดสอบขั้นต่ำที่วัดคุณภาพได้ (ต่ำกว่า = ยังไม่รายงานคุณภาพ)
  confidenceHigh   Float    @default(0.8) // คะแนนความเชื่อมั่นตั้งแต่ค่านี้ขึ้นไป = HIGH
  confidenceMedium Float    @default(0.6) // ตั้งแต่ค่านี้ถึงความสูง = MEDIUM (ต่ำกว่า = LOW)
  auditSampleSize  Int      @default(20) // จำนวนแถวต่อรอบสุ่มตรวจ (10–100)
  updatedBy        String? // email ผู้บันทึกล่าสุด (audit trail)
  updatedAt        DateTime @updatedAt
}

// นโยบายการเก็บรักษา Audit Log (v0.30.0) — singleton แถวเดียวของระบบ (id = 1)
// กำหนด "เก็บ log ไว้กี่วัน" — ลบของเก่าได้เฉพาะผู้มีสิทธิ์ MANAGE_USERS จากหน้า "ศูนย์บันทึกตรวจสอบ"
// ทุกการตั้งค่าและการลบจริงถูกบันทึกลง AuditLog ด้วย (meta-audit: SET_AUDIT_RETENTION / AUDIT_LOG_PRUNE)
model AuditPolicy {
  id            Int      @id @default(1)
  retentionDays Int      @default(365) // จำนวนวันที่เก็บบันทึกไว้ (30–3650) — เกินกำหนดถือว่าหมดอายุ
  updatedBy     String? // email ผู้บันทึกล่าสุด (audit trail)
  updatedAt     DateTime @updatedAt
}

// แผนงาน DQ (v0.34.0) — Task ของแผนทวนสอบคุณภาพข้อมูลราย Data Domain รายปี (2026–2030)
// แต่ละ Task มี "น้ำหนักคะแนน" (weight 1–5) และ "ความคืบหน้า" (progress 0–100)
// หน้า "แผนงาน DQ" รวม progress แบบถ่วงน้ำหนัก: Σ(weight×progress)/Σ(weight) ทั้งระบบ รายปี และราย Data Domain
// สถานะ: 0 = วางแผน · 1–99 = กำลังดำเนินการ · 100 = เสร็จสิ้น (derive จาก progress)
model ProjectTask {
  id          String   @id @default(cuid())
  title       String
  detail      String   @default("")
  // แนวงานตาม Data Domain (ชื่อโดเมนเพื่อ group แผนแม่บท 2026–2030 — สอดคล้องชื่อ DataDomain ในระบบ)
  domainLabel String
  year        Int // ปีแผนงาน ค.ศ. เช่น 2026
  quarter     Int      @default(1) // ไตรมาสเริ่มต้น 1–4
  weight      Int      @default(1) // น้ำหนักคะแนน 1–5 (task ใหญ่/สำคัญ = น้ำหนักมาก)
  progress    Int      @default(0) // ความคืบหน้า 0–100
  ownerRole   String   @default("DATA_STEWARD") // บทบาทผู้รับผิดชอบหลัก (RoleKey)
  sortOrder   Int      @default(0)
  createdBy   String   @default("") // email ผู้สร้าง (audit trail)
  updatedBy   String? // email ผู้บันทึกล่าสุด (audit trail)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([year, domainLabel])
}
